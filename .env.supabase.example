# Copy to .env.supabase; keep the actual file private and untracked.
MAZI_BACKEND=supabase
MAZI_DATABASE_SCHEMA=mazi
# Use the session pooler, restricted mazi_app login, and the downloaded provider CA.
MAZI_DATABASE_URL="host=SESSION_POOLER_HOST port=5432 dbname=postgres user=mazi_app.PROJECT_REF password=COMPLETE_DATABASE_PASSWORD sslmode=verify-full sslrootcert=infra/hosted/prod-ca-2021.crt"
MAZI_SUPABASE_URL=https://PROJECT_REF.supabase.co
# Complete server secret, not the masked dashboard prefix; never a VITE_ variable.
MAZI_SUPABASE_SECRET_KEY=REPLACE_WITH_COMPLETE_SERVER_SECRET
MAZI_STORAGE_BUCKET=mazi-private
# Scratch only. Durable records and bytes are hosted; preserve .mazi-imports separately.
MAZI_IMPORT_DATA_DIR=.mazi-hosted
