  "narrative": {
    "northStar": "The Atlas of Us",
    "overview": "The Atlas of Us pairs a midnight blue cartographic ground with warm ivory serif lettering and copper selection. Photography remains the dominant material; the dated curved chart gives memories a spatial index. Controls are restrained and readable.\n\nThis record describes the implemented local synthetic experiment, not an accepted production standard. The team selected Atlas; the finish verdict clears experiment readiness and three resolved fixes. Numerical comp gates remain incomplete in `.impeccable/build/REVIEW_STATUS.md`; no pixel-fidelity certification is claimed. The reported 20 passing Chromium desktop/phone-emulation contracts do not establish real-phone, browser-matrix, manual screen-reader, GPU or friend-study outcomes.",
    "keyCharacteristics": [
      "Midnight blue ground with warm photographic emphasis.",
      "Ivory serif hierarchy; sans-serif source evidence and utility controls.",
      "Copper marks selection, actions and chart accents.",
      "Real procedural depth with equivalent dated HTML controls."
    ],
    "rules": [
      {
        "name": "The Selection Rule",
        "body": "Copper identifies the current memory in the chart, dated controls and memory list.",
        "section": "colors"
      },
      {
        "name": "The Evidence Rule",
        "body": "Keep photographs, dates and source context readable together; utility text uses the sans-serif where implemented.",
        "section": "typography"
      },
      {
        "name": "The Chart Rule",
        "body": "Depth belongs to the procedural date chart; surrounding photographs and controls remain flat.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do retain visible synthetic provenance and truthful fixture photo counts.",
      "Do preserve photo-first phone reflow and conventional dated selection controls.",
      "Do preserve focus visibility, recovery controls and live reduced-motion behavior."
    ],
    "donts": [
      "Don't replace photographic content with decorative chart density.",
      "Don't require orbit or dragging to reach a memory.",
      "Don't treat this experiment's tokens or review as production acceptance."
    ]
  }
