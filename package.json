{
  "name": "mazi",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/run-app.mjs",
    "dev:supabase": "node scripts/run-app.mjs --supabase",
    "start:supabase": "npm run build && node scripts/run-app.mjs --built --supabase",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:unit": "node --test \"tests/unit/*.test.ts\"",
    "check:docs": "python3 work/poteto/product-plan/verify_docs.py",
    "check:budgets": "node scripts/check-budgets.mjs",
    "typecheck": "tsc -b",
    "lint": "prettier --check src \"tests/**/*.ts\" scripts/*.mjs vite.config.ts playwright*.config.ts package.json tests/dom/timeline-dates.test.mjs",
    "format": "prettier --write src \"tests/**/*.ts\" scripts/*.mjs vite.config.ts playwright*.config.ts package.json tests/dom/timeline-dates.test.mjs",
    "m0:start": "supabase start -x realtime,imgproxy,mailpit,postgres-meta,studio,edge-runtime,logflare,vector,supavisor",
    "m0:stop": "supabase stop",
    "test:m0": "node --test tests/m0/*.test.mjs",
    "eval:retrieval": ".venv/bin/python -m mazi.discovery.evaluate",
    "setup:discovery:model": ".venv/bin/python -m mazi.discovery.download_model",
    "eval:retrieval:clip": ".venv/bin/python -m mazi.discovery.evaluate_clip",
    "eval:answers": ".venv/bin/python -m mazi.answers.evaluate",
    "start": "npm run build && node scripts/run-app.mjs --built",
    "setup": "python3 -m venv .venv && .venv/bin/python -m pip install -r requirements.txt",
    "test:postgres": "node --env-file=.env.supabase -e \"process.exit(require('node:child_process').spawnSync('.venv/bin/python', ['-m', 'unittest', 'tests.backend.test_postgres'], {stdio:'inherit', env:{...process.env, MAZI_TEST_POSTGRES:'1'}}).status ?? 1)\"",
    "test:backend": ".venv/bin/python -m unittest discover -s tests/backend -t .",
    "test:app": "playwright test --config playwright.unified.config.ts",
    "test:domains": "playwright test --config tests/browser/playwright.config.ts",
    "dev:local": "node scripts/run-app.mjs --local",
    "start:local": "npm run build && node scripts/run-app.mjs --built --local",
    "archive:migrate": "node --env-file=.env.supabase -e \"process.exit(require('node:child_process').spawnSync('.venv/bin/python', ['-m', 'mazi.archive.migrate', ...process.argv.slice(1)], {stdio:'inherit', env:process.env}).status ?? 1)\" --",
    "archive:hosted": "node --env-file=.env.supabase -e \"process.exit(require('node:child_process').spawnSync('.venv/bin/python', ['-m', 'mazi.archive.hosted_ops', ...process.argv.slice(1)], {stdio:'inherit', env:process.env}).status ?? 1)\" --",
    "places:backfill": "node --env-file=.env.supabase -e \"process.exit(require('node:child_process').spawnSync('.venv/bin/python', ['-m', 'mazi.sources.backfill_places'], {stdio:'inherit', env:process.env}).status ?? 1)\"",
    "test:dom": "node --test tests/dom/*.test.mjs"
  },
  "dependencies": {
    "@fontsource/geist": "5.3.0",
    "@fontsource/geist-mono": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@react-three/fiber": "9.8.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.1",
    "happy-dom": "21.0.3",
    "prettier": "3.9.9",
    "supabase": "2.119.0",
    "typescript": "7.0.2",
    "vite": "8.3.2"
  }
}
