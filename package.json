{
  "name": "mazi-atlas-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "check:docs": "python3 work/poteto/product-plan/verify_docs.py",
    "typecheck": "tsc -b",
    "lint": "prettier --check src tests vite.config.ts playwright.config.ts package.json",
    "format": "prettier --write src tests vite.config.ts playwright.config.ts package.json",
    "m0:start": "supabase start -x realtime,imgproxy,mailpit,postgres-meta,studio,edge-runtime,logflare,vector,supavisor",
    "m0:stop": "supabase stop",
    "test:m0": "node --test tests/m0/*.test.mjs"
  },
  "dependencies": {
    "@fontsource/libre-caslon-text": "5.3.0",
    "@fontsource/source-sans-3": "5.3.0",
    "@react-three/fiber": "9.8.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.1",
    "prettier": "3.9.9",
    "supabase": "2.119.0",
    "typescript": "7.0.2",
    "vite": "8.3.2"
  }
}
